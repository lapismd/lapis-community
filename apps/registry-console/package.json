{
  "name": "@lapismd/registry-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=esm --platform=browser --target=es2023 --outfile=dist/assets/main.js && node scripts/copy-static.mjs",
    "check:types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "start": "node scripts/serve.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@lapismd/registry-nostr": "^0.0.0",
    "@lapismd/registry-protocol": "^0.0.0",
    "nostr-tools": "^2.25.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
