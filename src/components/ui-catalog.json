      "requirement": "LC-UI-038",
      "variants": ["compact", "form", "wide", "sidebar"],
      "requiredStates": ["open", "scroll", "close", "focus-restored"],
      "loading": {
        "applicable": false,
        "states": [],
        "reason": "Page loading is demonstrated by the Loading pattern; this composition does not fetch data."
      },
      "when": "Editing forms and content dialogs; pages provide snippets, never overlay geometry.",
      "productionStories": ["community-agents-directory--add-agent"],
      "verification": {
        "open": "community-patterns-dialog--contract",
        "focus-restored": "community-patterns-dialog--contract",
        "close": "community-patterns-dialog--contract",
        "scroll": "community-patterns-dialog--contract"
      }
    },
