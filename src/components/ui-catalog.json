    {
      "file": "src/components/community-search-command/CommunitySearchCommand.svelte",
      "rule": "dialog",
      "symbol": "component internals: :global(.community-search-dialog[data-ui-part=\"dialog-content\"])",
      "reason": "The Command View host restores the specified wide top-aligned palette geometry while its content remains owned by the public Command View family.",
      "story": "community-search-search-command--results",
      "requirement": "LC-UI-019"
    },
