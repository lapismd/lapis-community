{
  "name": "lapis-nostr-plugin-registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check:types": "pnpm -r --if-present check:types",
    "test": "pnpm -r --if-present test",
    "check:format": "prettier . --check --log-level warn",
    "fmt": "prettier . --write --log-level warn",
    "check": "pnpm check:types && pnpm test && pnpm build && pnpm check:format"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "prettier": "3.3.3",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
