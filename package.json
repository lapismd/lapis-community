{
  "name": "lapis-nostr-plugin-registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check:types": "tsc -p tsconfig.scripts.json --noEmit && pnpm -r --if-present check:types",
    "test": "pnpm -r --if-present test",
    "smoke:local": "scripts/smoke-local-e2e.sh",
    "smoke:long-thread": "REGISTRY_FIXTURE_LONG_THREAD_POSTS=2000 scripts/smoke-local-e2e.sh",
    "local:up": "scripts/local-stack.sh up",
    "local:down": "scripts/local-stack.sh down",
    "local:reset": "scripts/local-stack.sh reset",
    "local:logs": "scripts/local-stack.sh logs -f",
    "local:ps": "scripts/local-stack.sh ps",
    "local:validate": "scripts/validate-local-e2e.sh",
    "local:smoke": "scripts/smoke-local-e2e.sh",
    "registry:materialize": "tsx scripts/materialize-registry.ts",
    "check:format": "prettier . --check --log-level warn",
    "fmt": "prettier . --write --log-level warn",
    "check": "pnpm build && pnpm check:types && pnpm test && pnpm check:format"
  },
  "devDependencies": {
    "@lapismd/registry-auth": "workspace:*",
    "@lapismd/registry-nostr": "workspace:*",
    "@lapismd/registry-protocol": "workspace:*",
    "@types/node": "^25.0.0",
    "nostr-tools": "^2.25.1",
    "prettier": "3.3.3",
    "prettier-plugin-svelte": "^3.5.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
