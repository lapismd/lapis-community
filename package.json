{
  "name": "@lapismd/lapis-community",
  "version": "0.1.0",
  "description": "Nostr protocol, relay access, registry materialization, and community components for Lapis",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/lapis-community.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./nostr": {
      "types": "./dist/nostr/index.d.ts",
      "import": "./dist/nostr/index.js",
      "default": "./dist/nostr/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js",
      "default": "./dist/protocol/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "svelte": "./dist/components/index.js",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./community": {
      "types": "./dist/community/index.d.ts",
      "import": "./dist/community/index.js",
      "default": "./dist/community/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js",
      "default": "./dist/registry/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./client/registry-community.js": "./dist/client/registry-community.js"
  },
  "scripts": {
    "build": "pnpm prepack",
    "prepack": "svelte-package --input src --tsconfig ./tsconfig.pack.json && vite build && publint",
    "check": "pnpm spec:validate && pnpm check:svelte && pnpm check:types",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --output human",
    "check:types": "tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --project unit",
    "test:relay": "vitest run --project unit src/testing/relay-contract.test.ts",
    "test:relay:docker": "scripts/community-relay.sh test",
    "test:storybook": "vitest run --project storybook",
    "test:storybook:docker": "scripts/community-relay.sh storybook-test",
    "dev:community": "vite --config vite.community.config.ts --open",
    "storybook": "WATCHPACK_POLLING=250 node scripts/storybook-run.mjs --no-open --config-dir .storybook",
    "storybook:stop": "bash scripts/storybook-stop.sh",
    "storybook:restart": "bash scripts/storybook-restart.sh",
    "storybook:relay": "scripts/community-relay.sh storybook",
    "build-storybook": "storybook build --config-dir .storybook --output-dir storybook-static",
    "spec:build": "spec-validator build",
    "spec:check": "spec-validator check",
    "spec:first": "spec-validator first",
    "spec:validate": "spec-validator validate",
    "registry:materialize": "tsx src/materializer/materialize-registry.ts",
    "fixture:init": "tsx src/fixture/init.ts",
    "fixture:start": "tsx src/fixture/seed.ts",
    "smoke:local": "scripts/smoke-local-e2e.sh",
    "smoke:long-thread": "REGISTRY_FIXTURE_LONG_THREAD_POSTS=2000 scripts/smoke-local-e2e.sh",
    "local:up": "scripts/local-stack.sh up",
    "local:down": "scripts/local-stack.sh down",
    "local:reset": "scripts/local-stack.sh reset",
    "local:logs": "scripts/local-stack.sh logs -f",
    "local:ps": "scripts/local-stack.sh ps",
    "local:validate": "scripts/validate-local-e2e.sh",
    "local:smoke": "scripts/smoke-local-e2e.sh",
    "relay:up": "scripts/community-relay.sh up",
    "relay:down": "scripts/community-relay.sh down",
    "relay:reset": "scripts/community-relay.sh reset",
    "check:format": "prettier . --check --log-level warn",
    "fmt": "prettier . --write --log-level warn",
    "checks": "pnpm check:format && pnpm spec:check && pnpm check && pnpm test && pnpm test:storybook && pnpm test:storybook:docker && pnpm build-storybook && pnpm build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@emoji-mart/data": "^1.2.1",
    "@lapismd/design-core": "^0.1.0",
    "@lapismd/mira": "^0.0.2",
    "@lucide/svelte": "^1.21.0",
    "@noble/hashes": "^2.4.0",
    "@tursodatabase/database-wasm": "0.7.2",
    "emoji-mart": "^5.6.0",
    "idb": "8.0.3",
    "nostr-tools": "^2.25.1",
    "semver": "^7.7.2",
    "sharp": "^0.34.5",
    "svelte-sonner": "^1.2.1",
    "zod": "^4.3.5"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@lapismd/spec-validator": "0.1.0",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@storybook/addon-themes": "10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/icons": "2.1.0",
    "@storybook/svelte-vite": "10.5.7",
    "@sveltejs/package": "2.5.0",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tsconfig/svelte": "5.0.5",
    "@types/node": "^22.15.0",
    "@types/semver": "^7.7.1",
    "@vitest/browser": "4.1.8",
    "@vitest/browser-playwright": "4.1.8",
    "aria-query": "5.3.2",
    "fake-indexeddb": "6.2.5",
    "playwright": "1.61.1",
    "prettier": "3.3.3",
    "prettier-plugin-svelte": "^3.5.2",
    "publint": "0.3.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.5.7",
    "svelte": "5.56.9",
    "svelte-check": "4.3.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "vite": "6.4.2",
    "vitest": "4.1.8"
  }
}
