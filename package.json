{
  "name": "lapis-nostr-plugin-registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check:types": "tsc -p tsconfig.scripts.json --noEmit && pnpm -r --if-present check:types",
    "test": "pnpm test:root && pnpm -r --if-present test",
    "test:root": "vitest run scripts",
    "deploy:check": "scripts/validate-deploy.sh",
    "smoke:local": "scripts/smoke-local-e2e.sh",
    "local:up": "scripts/local-stack.sh up",
    "local:down": "scripts/local-stack.sh down",
    "local:reset": "scripts/local-stack.sh reset",
    "local:logs": "scripts/local-stack.sh logs -f",
    "local:ps": "scripts/local-stack.sh ps",
    "local:up:quorum": "scripts/local-stack.sh --quorum up",
    "local:down:quorum": "scripts/local-stack.sh --quorum down",
    "local:reset:quorum": "scripts/local-stack.sh --quorum reset",
    "local:logs:quorum": "scripts/local-stack.sh --quorum logs -f",
    "local:ps:quorum": "scripts/local-stack.sh --quorum ps",
    "local:validate": "scripts/validate-local-e2e.sh",
    "local:validate:quorum": "scripts/validate-local-e2e.sh --quorum",
    "local:smoke": "scripts/smoke-local-e2e.sh",
    "local:smoke:quorum": "scripts/smoke-local-e2e.sh --quorum",
    "relay:materialize": "tsx scripts/materialize-relays.ts",
    "v1:check": "tsx scripts/import-v1.ts --source ../plugin-registry/generated/v1 --check",
    "v1:import": "tsx scripts/import-v1.ts --source ../plugin-registry/generated/v1 --output artifacts/v1-import.json",
    "check:format": "prettier . --check --log-level warn",
    "fmt": "prettier . --write --log-level warn",
    "check": "pnpm build && pnpm check:types && pnpm test && pnpm check:format"
  },
  "devDependencies": {
    "@lapismd/registry-nostr": "workspace:*",
    "@lapismd/registry-protocol": "workspace:*",
    "@types/node": "^25.0.0",
    "prettier": "3.3.3",
    "tsx": "^4.20.6",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
